diff --git a/runtime/port/mem/frame.c b/runtime/port/mem/frame.c
index c223eea..ae836f0 100644
--- a/runtime/port/mem/frame.c
+++ b/runtime/port/mem/frame.c
@@ -68,16 +68,24 @@ unsigned char *port_frame_alloc(void)
 #include <stdio.h>
 #include <sys/mman.h>
 #include <unistd.h>
+#ifdef __ANDROID__
+#include <sys/syscall.h>
+#endif
 
 unsigned char *port_frame_alloc(void)
 {
     char name[64];
     unsigned char *base;
     int fd;
+#ifdef __ANDROID__
+    fd = (int)syscall(__NR_memfd_create, "underworld-ems", 1);
+    if (fd < 0) return NULL;
+#else
     snprintf(name, sizeof name, "/exhume-ems-%d", (int)getpid());
     fd = shm_open(name, O_RDWR | O_CREAT | O_EXCL, 0600);
     if (fd < 0) return NULL;
     shm_unlink(name);
+#endif
     if (ftruncate(fd, 0x10000)) { close(fd); return NULL; }
     base = mmap(NULL, 0x24000, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
     if (base == MAP_FAILED) { close(fd); return NULL; }
